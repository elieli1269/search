{
  "name": "semantic-ai-browser",
  "version": "0.2.0",
  "description": "An experimental AI-first web browser with semantic page indexing and Groq-powered assistance.",
  "main": "src/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "lint": "node scripts/lint.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.semanticai.browser",
    "productName": "Semantic AI Browser",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json",
      "README.md"
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Semantic-AI-Browser-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Semantic-AI-Browser-Portable-${version}.${ext}"
    }
  }
}
